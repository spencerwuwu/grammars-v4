lexer grammar MimeLexer;

// Basic delimiters
COLON               : ':';
SEMICOLON           : ';';
SLASH               : '/';
EQUALS              : '=';
COMMA               : ',';
LPAREN              : '(';
RPAREN              : ')';
LANGLE              : '<';
RANGLE              : '>';
DQUOTE              : '"';
DOUBLE_DASH         : '--';

// Line terminators
CRLF                : '\r\n';
LF                  : '\r'? '\n';

// Whitespace and folding
WSP                 : [ \t]+;
FWS                 : (WSP? (CRLF | LF) WSP+) | WSP+;

// Comments (RFC 2822 style)
COMMENT             : '(' (COMMENT_CONTENT | COMMENT)* ')';
fragment COMMENT_CONTENT : ~[()\\] | ('\\' .);

// Boundary markers
BOUNDARY_START      : DOUBLE_DASH BOUNDARY_CHARS;
BOUNDARY_END        : DOUBLE_DASH BOUNDARY_CHARS DOUBLE_DASH;

// Tokens
header_name         : (ALPHA)(ALPHA | DIGIT | '-')*;
TOKEN               : (ALPHA | DIGIT | [!#$%&'*+\-^_`|~])+;
//QUOTED_STRING       : DQUOTE (~["\r\n\\] | ('\\' .))* DQUOTE;
VERSION             : DIGIT+ '.' DIGIT+;
DIGITS              : DIGIT+;
DIGIT               : [0-9];
ALPHA               : [a-zA-Z];

// Content types
fragment BOUNDARY_CHARS : [a-zA-Z0-9'()+_,\-./:=?]+;

// Generic content
contentData        : (~[\r\n\-] | ('-' ~'-'))+ ;
contentLine        : contentData? (CRLF | LF);

// Skip standalone whitespace
SKIP_WSP            : [ \t] -> skip;
